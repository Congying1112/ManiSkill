<mujoco model="stick">
  <compiler angle="radian" meshdir="." />
  <default>
    <geom type="mesh"/>
    <default class="material-stick">
      <geom rgba="0.5 0.5 0.5 1"/>
    </default>
  </default>
  <asset>
    <mesh name="stick" file="../assets/stick.stl" scale="1 3 3"/>
  </asset>
  <worldbody>
    <body name="stick_body" pos="0 0 0">
      <geom type="mesh" mesh="stick" pos="0 0 0" quat="1 0 0 0" class="material-stick"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>
    </body>
  </worldbody>
</mujoco>
